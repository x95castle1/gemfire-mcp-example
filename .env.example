# Copy to .env and fill in. `.env` is gitignored.

# GemFire image for the demo cluster.
# 10.3.3+ or 10.2.9+ is needed for live CPU, uptime and JVM-pause metrics in list_members.
GEMFIRE_IMAGE=gemfire/gemfire:10.3.4-jdk17

# Vendor artifact versions (files in ./vendor)
GF_MCP_VERSION=1.0.0

# Basic auth for MCP clients calling the GemFire MCP server (both are required, or it won't start).
# Lab: admin/admin, which .mcp.json (Claude Code) also uses: Basic YWRtaW46YWRtaW4=
GF_MCP_AUTH_BASIC_USERNAME=admin
GF_MCP_AUTH_BASIC_PASSWORD=admin

# Broadcom Artifactory credentials (chunk 5: workload app build)
GEMFIRE_ARTIFACTORY_USERNAME=
GEMFIRE_ARTIFACTORY_PASSWORD=

# Claude API key (chunk 9: sre-assistant)
ANTHROPIC_API_KEY=

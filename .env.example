# Copy to .env and fill in. `.env` is gitignored.

# GemFire image for the demo cluster.
# 10.3.3+ or 10.2.9+ is needed for live CPU, uptime and JVM-pause metrics in list_members.
GEMFIRE_IMAGE=gemfire/gemfire:10.3.4-jdk17

# Vendor artifact versions (files in ./vendor)
GF_MCP_VERSION=1.0.0

# Chunk 10: security ON = merge compose.security.yaml into every docker compose command (and every script).
# Uncomment, then: make stop && make start. Comment it out again (and stop/start) to go back. See docs/10-security.md.
# COMPOSE_FILE=compose.yaml:compose.security.yaml

# Basic auth for MCP clients calling the GemFire MCP server (both are required, or it won't start).
# Lab: admin/admin. Used while security is off (chunk 10 switches the MCP server to OAuth tokens).
GF_MCP_AUTH_BASIC_USERNAME=admin
GF_MCP_AUTH_BASIC_PASSWORD=admin

# Broadcom Artifactory credentials (chunk 5: workload app build)
GEMFIRE_ARTIFACTORY_USERNAME=
GEMFIRE_ARTIFACTORY_PASSWORD=

# Claude API key (chunk 9: sre-assistant). From https://console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
# Optional model overrides for the sre-assistant (defaults shown)
# CLAUDE_MODEL=claude-opus-5-5
# OLLAMA_MODEL=qwen3:14b

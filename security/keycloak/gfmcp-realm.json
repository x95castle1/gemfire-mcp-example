{
  "realm": "gfmcp",
  "enabled": true,
  "displayName": "GemFire MCP lab",
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "gemfire-reader",
        "description": "may call MCP tools (token scope gemfire:read)"
      },
      {
        "name": "gemfire-log-reader",
        "description": "may also read logs (token scope gemfire:logs)"
      }
    ]
  },
  "groups": [
    {
      "name": "sre",
      "path": "/sre",
      "realmRoles": [
        "gemfire-reader",
        "gemfire-log-reader"
      ]
    },
    {
      "name": "viewers",
      "path": "/viewers",
      "realmRoles": [
        "gemfire-reader"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Lab",
      "email": "admin@gfmcp.lab",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "groups": [
        "/sre"
      ]
    },
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Viewer",
      "lastName": "Lab",
      "email": "viewer@gfmcp.lab",
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "groups": [
        "/viewers"
      ]
    },
    {
      "username": "jeremy",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Jeremy",
      "lastName": "Lab",
      "email": "jeremy@gfmcp.lab",
      "credentials": [
        {
          "type": "password",
          "value": "VMware1!",
          "temporary": false
        }
      ],
      "groups": [
        "/sre"
      ]
    },
    {
      "username": "andrew",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Andrew",
      "lastName": "Lab",
      "email": "andrew@gfmcp.lab",
      "credentials": [
        {
          "type": "password",
          "value": "VMware1!",
          "temporary": false
        }
      ],
      "groups": [
        "/sre"
      ]
    },
    {
      "username": "robert",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Robert",
      "lastName": "Lab",
      "email": "robert@gfmcp.lab",
      "credentials": [
        {
          "type": "password",
          "value": "VMware1!",
          "temporary": false
        }
      ],
      "groups": [
        "/viewers"
      ]
    },
    {
      "username": "service-account-lab-cli",
      "enabled": true,
      "serviceAccountClientId": "lab-cli",
      "realmRoles": [
        "gemfire-reader",
        "gemfire-log-reader"
      ]
    },
    {
      "username": "service-account-lab-viewer",
      "enabled": true,
      "serviceAccountClientId": "lab-viewer",
      "realmRoles": [
        "gemfire-reader"
      ]
    },
    {
      "username": "service-account-sre-assistant",
      "enabled": true,
      "serviceAccountClientId": "sre-assistant",
      "realmRoles": [
        "gemfire-reader"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "description": "sub claim",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "description": "preferred_username and name",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "gemfire:read",
      "protocol": "openid-connect",
      "description": "call GemFire MCP tools",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience gemfire-mcp-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "gemfire-mcp-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "gemfire:logs",
      "protocol": "openid-connect",
      "description": "read GemFire logs through MCP (search_logs)",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "gemfire:read",
      "roles": [
        "gemfire-reader"
      ]
    },
    {
      "clientScope": "gemfire:logs",
      "roles": [
        "gemfire-log-reader"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "gemfire-mcp-server",
      "name": "GemFire MCP server",
      "description": "the API (resource server); only an audience, it never logs in",
      "enabled": true,
      "publicClient": false,
      "secret": "unused-gemfire-mcp-server",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "sre-assistant",
      "name": "SRE assistant",
      "description": "people log in here (authorization code + PKCE); it swaps their token for an MCP token in their name (standard token exchange). Its own service account (read only) does the MCP handshake at startup.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "sre-assistant-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "rootUrl": "http://localhost:18080",
      "redirectUris": [
        "http://localhost:18080/login/oauth2/code/*"
      ],
      "webOrigins": [
        "http://localhost:18080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "standard.token.exchange.enabled": "true",
        "post.logout.redirect.uris": "http://localhost:18080/*"
      },
      "protocolMappers": [
        {
          "name": "audience sre-assistant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "sre-assistant",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "profile"
      ],
      "optionalClientScopes": [
        "gemfire:read",
        "gemfire:logs"
      ]
    },
    {
      "clientId": "lab-cli",
      "name": "lab-cli",
      "description": "scripts, Claude Code and MCP Inspector (client credentials): read + logs",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "lab-cli-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "gemfire:read",
        "gemfire:logs"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "lab-viewer",
      "name": "lab-viewer",
      "description": "the scripted RBAC demo (client credentials): read only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "lab-viewer-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "gemfire:read",
        "gemfire:logs"
      ],
      "optionalClientScopes": []
    }
  ]
}

    {
      "type": "timeseries",
      "title": "MCP HTTP requests / min by status",
      "id": 16,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({service=\"mcp-server\"} |= \"gf-mcp.audit\" | regexp `(?P<audit>\\{.*\\})\\s*$` | line_format `{{.audit}}` | json status [1m]))",
          "queryType": "range",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "description": "One audit line per HTTP request. Every MCP call is POST /mcp, so this shows traffic, not which tool was called. A tools/call is a session: initialize (200), initialized (202), the call (200), DELETE (200)."
    },
    {
      "type": "timeseries",

    {
      "type": "timeseries",
      "title": "Tenured heap used (eviction 75%, critical 90%)",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "100 * sum by (node) (gemfire_jvm_memory_used_bytes{area=\"heap\",id=\"G1 Old Gen\"}) / sum by (node) (gemfire_jvm_memory_max_bytes{area=\"heap\",id=\"G1 Old Gen\"})",
          "range": true,
          "instant": false,
          "legendFormat": "{{node}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "GemFire's eviction/critical thresholds are on tenured (old gen) heap. heap-hog pushes this into the red."
    },
